    },
    {
      "scene": "title",
      "text": "Free, and built for agents.",
      "file": "audio/line-01.mp3",
      "startMs": 6599,
      "durationMs": 3082
    },
    {
      "scene": "setup",
      "text": "Paste one prompt into your agent and it configures itself.",
      "file": "audio/line-02.mp3",
      "startMs": 10301,
      "durationMs": 4441
    },
    {
      "scene": "setup",
      "text": "There is no API key to copy. It authorizes over OAuth, and you approve once.",
      "file": "audio/line-03.mp3",
      "startMs": 15042,
      "durationMs": 7314
    },
    {
      "scene": "create",
      "text": "Ask for a database, and you get a connection string back.",
      "file": "audio/line-04.mp3",
      "startMs": 22976,
      "durationMs": 4650
    },
    {
      "scene": "create",
      "text": "Two hundred and forty one milliseconds, measured in production.",
      "file": "audio/line-05.mp3",
      "startMs": 27926,
      "durationMs": 5016
    },
    {
      "scene": "query",
      "text": "The same agent runs SQL against it directly, with no driver in between.",
      "file": "audio/line-06.mp3",
      "startMs": 33562,
      "durationMs": 5878
    },
    {
      "scene": "query",
      "text": "Give it a time to live, and the database cleans itself up.",
      "file": "audio/line-07.mp3",
      "startMs": 39740,
      "durationMs": 4702
    },
    {
      "scene": "outro",
      "text": "Five databases, five hundred megabytes each, free while in alpha.",
