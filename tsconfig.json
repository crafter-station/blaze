{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	/*
	 * `demo` is a separate Remotion project with its own package.json and node_modules.
	 * The include globs above sweep the whole tree, so without this the web app's type
	 * check tries to resolve `remotion` against the app's dependencies and fails — which is
	 * exactly what broke the Docker build, where demo's node_modules are not installed.
	 */
	"exclude": ["node_modules", "demo"]
}
