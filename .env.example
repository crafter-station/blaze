# blaze — control plane
# Copy to .env.local for development.

# blaze's own Postgres. NOT a tenant database.
DATABASE_URL=postgresql://blaze:blaze@localhost:5432/blaze

# 32 bytes, hex. Encrypts tenant connection passwords (reversible by design — the
# dashboard has to render a working connection string).
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Apex domain connection hostnames hang off: blaze.run -> pg.blaze.run
# Never an IP. See PLAN.md §3.
BLAZE_DOMAIN=blaze.run

# Clerk. Signup is OAuth-only (GitHub + Google) — configure that in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/projects

# Dokploy — used only to provision dedicated containers (redis, libsql).
DOKPLOY_API_URL=https://vps.crafter.run/api
DOKPLOY_API_KEY=
